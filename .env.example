# Settings for the /api/chat function (api/chat.ts), which answers from corpus/pages.json.
# Copy this file to .env.local for `vercel dev`, and set the same variables in the
# Vercel project settings for deployments. Never commit real values.
#
# Any OpenAI-compatible endpoint that supports response_format json_schema works. LLM_BASE_URL is the part before /chat/completions:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-a-model-id
